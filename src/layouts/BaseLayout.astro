---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { business, waLink } from '../data/business';
interface Crumb { name: string; url: string }
interface Props { title: string; description: string; canonicalPath?: string; image?: string; breadcrumb?: Crumb[]; }
const { title, description, canonicalPath = '/', image, breadcrumb } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://istanakosmetik-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink(`Halo ${business.name}, saya mau tanya stok produk. Apakah ready?`);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Rak produk' },
  { href: '/promo', label: 'Promo' },
  { href: '/tentang', label: 'Kunjungi' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} breadcrumb={breadcrumb} />
</head>
<body class="bg-paper text-ink font-sans antialiased">
  <a href="#konten" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-5 focus:py-3 focus:rounded-full focus:text-sm focus:bg-ink focus:text-paper">Lewati ke konten</a>

  <!-- Ref: masthead editorial ringkas — wordmark serif + nav bernomor, tanpa ikon dekoratif -->
  <header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-xl border-b rule">
    <nav class="max-w-7xl mx-auto px-4 md:px-8" aria-label="Navigasi utama">
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />
      <div class="grid grid-cols-[1fr_auto] md:grid-cols-[1fr_auto_1fr] items-center gap-3 py-3">
        <a href="/" class="font-display text-xl md:text-2xl leading-none tracking-tight">
          Istana <span class="italic text-accent">Cosmetics</span>
          <span class="block md:inline md:ml-2 text-[0.62rem] font-sans font-medium uppercase tracking-[0.28em] text-soft">Jambi</span>
        </a>

        <div class="hidden md:flex items-center justify-center gap-7 text-[0.7rem] font-medium uppercase tracking-[0.18em]">
          {nav.map((n) => (
            <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={["pb-1 border-b transition-colors hover:text-accent", active(n.href) ? "border-accent text-ink" : "border-transparent text-soft hover:border-accent"]}>{n.label}</a>
          ))}
        </div>

        <div class="flex items-center justify-end gap-2">
          <a href={cta} class="hidden sm:inline-flex items-center justify-center gap-2 bg-ink text-paper px-5 min-h-[46px] rounded-full text-[0.78rem] font-medium tracking-wide tap hover:bg-accent">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3.5 20.5l1.7-5A8.4 8.4 0 1 1 21 11.5Z"/></svg>
            Pesan via WA
          </a>
          <label for="nav-toggle" id="nav-label" aria-label="Buka atau tutup menu navigasi" class="md:hidden inline-flex items-center justify-center min-h-[46px] min-w-[46px] rounded-full border rule cursor-pointer tap">
            <svg class="icon-open" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close hidden" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </label>
        </div>
      </div>

      <div class="nav-panel md:hidden" id="menu-mobile">
        <div>
          <div class="pb-4 border-t rule pt-2">
            {nav.map((n, i) => (
              <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={["grid grid-cols-[auto_1fr] items-baseline gap-4 px-1 min-h-[52px] py-3 border-b rule text-lg transition-colors", active(n.href) ? "text-accent" : "hover:text-accent"]}>
                <span class="text-[0.66rem] font-medium tracking-[0.2em] text-soft">0{i + 1}</span>
                <span class="font-display">{n.label}</span>
              </a>
            ))}
            <a href={cta} class="mt-4 inline-flex w-full items-center justify-center gap-2 bg-ink text-paper px-5 min-h-[48px] rounded-full text-sm font-medium tap hover:bg-accent">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3.5 20.5l1.7-5A8.4 8.4 0 1 1 21 11.5Z"/></svg>
              Pesan via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main id="konten"><slot /></main>

  <!-- Ref: footer NAP ringkas — nama, alamat, telepon satu sumber (business.ts) -->
  <footer class="mt-24 border-t rule">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-14 grid grid-cols-1 md:grid-cols-12 gap-y-10 gap-x-8">
      <div class="md:col-span-5">
        <p class="font-display text-3xl md:text-4xl leading-none">Istana <span class="italic text-accent">Cosmetics</span></p>
        <p class="mt-3 text-[0.68rem] font-medium uppercase tracking-[0.28em] text-soft">{business.category} — {business.city}</p>
        <p class="mt-6 text-sm text-soft leading-relaxed max-w-prose">{business.address}. Buka {business.hours.toLowerCase()}. Harga di situs ini estimasi; konfirmasi via admin.</p>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-[0.66rem] font-medium uppercase tracking-[0.24em] text-soft">Halaman</h2>
        <ul class="mt-4 grid gap-1">
          {nav.map((n) => (
            <li><a href={n.href} class="inline-flex items-center min-h-[44px] text-sm link-underline hover:text-accent">{n.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <h2 class="text-[0.66rem] font-medium uppercase tracking-[0.24em] text-soft">Hubungi</h2>
        <ul class="mt-4 grid gap-3 text-sm">
          <li>
            <a href={cta} class="inline-flex items-center gap-3 min-h-[44px] hover:text-accent">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3.5 20.5l1.7-5A8.4 8.4 0 1 1 21 11.5Z"/></svg>
              <span>WhatsApp {business.phoneDisplay}</span>
            </a>
          </li>
          <li>
            <a href={business.mapsUrl} class="inline-flex items-center gap-3 min-h-[44px] hover:text-accent">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              <span>Rute ke lokasi (Google Maps)</span>
            </a>
          </li>
          <li>
            <a href={business.instagram} class="inline-flex items-center gap-3 min-h-[44px] hover:text-accent">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
              <span>Instagram @istana.cosmetics</span>
            </a>
          </li>
        </ul>
        <p class="mt-6 text-xs text-soft">© 2026 {business.name}. Nama, alamat, dan jam mengikuti data toko di halaman ini.</p>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
      const l = document.getElementById('nav-label');
      if (t && l) t.addEventListener('change', () => l.setAttribute('aria-expanded', t.checked ? 'true' : 'false'));
      document.querySelectorAll('[data-mapfacade]').forEach((root) => {
        const btn = root.querySelector('[data-mapbtn]');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const f = document.createElement('iframe');
          f.src = root.getAttribute('data-src') || '';
          f.title = root.getAttribute('data-title') || 'Peta toko';
          f.loading = 'lazy';
          f.className = 'w-full h-full border-0';
          root.replaceChildren(f);
        }, { once: true });
      });
    });
  </script>
</body>
</html>
