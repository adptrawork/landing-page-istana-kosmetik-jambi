---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { business, waLink } from '../data/business';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://istanakosmetik-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink(`Halo ${business.name}, saya mau tanya stok produk. Apakah ready?`);
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/promo', label: 'Promo' },
  { href: '/tentang', label: 'Tentang' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-[#faf8f2] text-zinc-950 antialiased">
  <a href="#konten" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded-full focus:text-sm focus:bg-white focus:text-zinc-950">Lewati ke konten</a>
  <header class="sticky top-0 z-40 bg-[#faf8f2]/80 backdrop-blur-xl border-b border-amber-900/10">
    
    <nav class="max-w-7xl mx-auto px-4" aria-label="Navigasi utama">
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />
      <div class="flex items-center justify-between py-3 gap-3">
        <a href="/" class="font-extrabold tracking-tighter text-sm md:text-base">ISTANA <span class="text-amber-700">COSMETICS</span></a>
        <div class="hidden md:flex gap-6 text-sm text-zinc-600">
          {nav.map((n) => (
            <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={["transition " + "hover:text-zinc-950", active(n.href) && "text-zinc-950 font-semibold underline underline-offset-8 decoration-amber-700"]}>{n.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-2">
          <a href={cta} class="hidden sm:inline-flex items-center justify-center bg-amber-700 text-white px-5 py-2.5 min-h-[48px] rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Minta Pricelist</a>
          <label for="nav-toggle" id="nav-label" aria-label="Buka atau tutup menu navigasi" aria-expanded="false" aria-controls="menu-mobile" class="md:hidden inline-flex items-center justify-center min-h-[48px] min-w-[48px] rounded-full border border-amber-900/10 cursor-pointer">
            <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </label>
        </div>
      </div>
      <div class="nav-panel md:hidden" id="menu-mobile">
        <div>
          <div class="flex flex-col gap-1 pb-4">
            {nav.map((n) => (
              <a href={n.href} aria-current={active(n.href) ? 'page' : undefined} class:list={["flex items-center w-full px-4 min-h-[48px] py-3 rounded-2xl text-base transition " + "hover:text-zinc-950", active(n.href) && "text-zinc-950 font-semibold underline underline-offset-8 decoration-amber-700"]}>{n.label}</a>
            ))}
            <a href={cta} class="sm:hidden inline-flex items-center justify-center bg-amber-700 text-white px-5 min-h-[48px] rounded-full text-sm font-medium mt-2">Minta Pricelist</a>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <main id="konten"><slot /></main>
  <footer class="mt-20 border-t border-amber-900/10 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="font-extrabold tracking-tighter text-lg">ISTANA COSMETICS JAMBI</p>
        <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">{business.address} — {business.hours}</p>
        <p class="mt-2 text-sm text-zinc-400 max-w-[65ch]">Harga dapat berubah, konfirmasi via WA toko. Label Terverifikasi = data dicek dari sumber resmi; Estimasi = perkiraan.</p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/" class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Beranda</a>
          <a href="/katalog" class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Katalog</a>
          <a href="/promo" class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Promo</a>
          <a href="/tentang" class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Tentang</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <p class="font-semibold text-sm">Hubungi</p>
        <div class="mt-3 flex flex-col gap-2 text-sm">
          <a href={cta} class="underline underline-offset-4 min-h-[48px] inline-flex items-center">WhatsApp ({business.phoneDisplay})</a>
          <a href={business.mapsUrl} class="underline underline-offset-4 min-h-[48px] inline-flex items-center">Google Maps — rute ke lokasi</a>
        </div>
        <p class="mt-6 text-xs text-zinc-400">© 2026 {business.name} — {business.city}.</p>
      </div>
    </div>
  </footer>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const t = document.getElementById('nav-toggle') as HTMLInputElement | null;
      const l = document.getElementById('nav-label');
      if (t && l) t.addEventListener('change', () => l.setAttribute('aria-expanded', t.checked ? 'true' : 'false'));
      document.querySelectorAll('[data-mapfacade]').forEach((root) => {
        const btn = root.querySelector('[data-mapbtn]');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const f = document.createElement('iframe');
          f.src = root.getAttribute('data-src') || '';
          f.title = root.getAttribute('data-title') || 'Peta toko';
          f.loading = 'lazy';
          f.className = 'w-full h-full border-0';
          root.replaceChildren(f);
        }, { once: true });
      });
    });
  </script>
</body>
</html>
