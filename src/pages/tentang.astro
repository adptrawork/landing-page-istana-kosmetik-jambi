---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, socials, storeNotes, waLink } from '../data/business';
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const cta = waLink(`Halo ${business.name}, saya mau tanya rute dan pricelist grosir.`);
---
<BaseLayout title={`Tentang — ${business.title}`} description={`Lokasi ${business.name} Kapt Bakaruddin No.17: grosir ecer, admin online, bukan Pekanbaru.`} canonicalPath="/tentang" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <div class="md:pl-[10vw]">
      <p class="text-sm font-bold uppercase tracking-widest text-amber-700 reveal">Tentang Grosir</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold max-w-[20ch] reveal d-1">{business.name}</h1>
      <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Bukan cabang Pekanbaru — ini toko Jambi di {business.address}.</p>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5 reveal d-2">
        <div class="bg-white border border-slate-200/50 rounded-[2rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <h2 class="font-extrabold tracking-tight text-lg">Alamat & Jam</h2>
          <p class="mt-3 text-base text-gray-600 leading-relaxed">{business.address}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-wide text-amber-700">Alamat: {business.addressStatus}</p>
          <p class="mt-4 text-base text-gray-600">{business.hours}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-wide text-amber-700">Jam: {business.hoursStatus}</p>
          <p class="mt-4 text-base text-gray-600">Telp/WA: {business.phoneDisplay}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={cta} class="bg-amber-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Minta Pricelist</a>
            <a href={business.mapsUrl} class="border border-zinc-300 px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Cari di Maps</a>
          </div>
        </div>
        <div class="mt-6 bg-amber-50 border border-amber-900/15 rounded-[2rem] p-8">
          <h2 class="font-extrabold tracking-tight text-lg">Akun Resmi</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm">{socials.map((s) => (<li><a href={s.url} class="underline underline-offset-4">{s.label}</a> <span class="text-zinc-500">— {s.note}</span></li>))}</ul>
        </div>
      </div>
      <div class="md:col-span-7 reveal d-3">
        <div class="-mt-2 rounded-[2rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={embed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <div class="mt-6 bg-white border border-slate-200/50 rounded-[2rem] p-8">
          <h2 class="font-extrabold tracking-tight text-lg">Catatan Toko</h2>
          <ul class="mt-3 text-base text-gray-600 leading-relaxed list-disc pl-5">{storeNotes.map((n) => (<li>{n}</li>))}</ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
