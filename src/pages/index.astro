---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
const heroCta = waLink(`Halo ${business.name}, saya mau minta pricelist grosir.`);
const featured = products.slice(0, 4);
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <!-- hero whitespace besar + visual overlap -->
  <section class="max-w-7xl mx-auto px-4 w-full pt-16 md:pt-28">
    <div class="md:pl-[16vw] reveal">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-amber-700">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8l8-4 8 4v8l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8"/></svg>
        <span>{business.rating} • Grosir & Ecer • {business.city}</span>
      </p>
      <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold">Istana Cosmetics Jambi — Grosir & Ecer Terlengkap</h1>
      <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Jl Kapt A Bakaruddin No.17. Satu atap untuk kulakan lusinan dan belanja satuan — minta pricelist grosir ke admin online, harga ecer estimasi.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={heroCta} class="bg-amber-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Minta Pricelist Grosir</a>
        <a href="/katalog" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:border-zinc-950 active:scale-[0.98]">Lihat Katalog</a>
      </div>
    </div>
    <div class="-mt-8 md:-mt-12 relative z-10 reveal d-2">
      <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] bg-zinc-100 aspect-[16/7]">
        <img src="/images/istana-hero.jpg" alt="Etalase Istana Cosmetics Jambi — foto resmi toko" width="1200" height="525" loading="eager" class="w-full h-full object-cover" />
      </div>
      <div class="mt-3 grid grid-cols-1 md:grid-cols-12 gap-4 text-sm">
        <div class="md:col-span-7 bg-white border border-slate-200/50 rounded-3xl p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]"><p class="font-bold">Skema Grosir</p><p class="mt-1 text-base text-gray-600">Lusinan & kartonan • pricelist via admin online 0895-3219-71081</p></div>
        <div class="md:col-span-5 bg-white border border-slate-200/50 rounded-3xl p-5 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]"><p class="font-bold">Skema Ecer</p><p class="mt-1 text-base text-gray-600">Satuan • {business.hours}</p></div>
      </div>
    </div>
  </section>

  <!-- accordion image slider -->
  <section class="max-w-7xl mx-auto px-4 py-14 w-full min-h-[70dvh]">
    <p class="text-sm font-bold uppercase tracking-widest text-amber-700 reveal">Sorotan Katalog</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-extrabold reveal d-1">Geser — sorot tiap produk</h2>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Arahkan kursor / ketuk strip gambar untuk memperbesar. <a class="underline underline-offset-4 text-zinc-900" href="/katalog">Lihat semua {products.length} produk</a></p>
    <div class="acc-strip mt-8 h-[46dvh] md:h-[60dvh]" role="list" aria-label="Slider produk unggulan">
      {featured.map((p, i) => (
        <div class="acc-panel relative bg-zinc-100 border border-slate-200/50 reveal" role="listitem" tabindex="0" style={`animation-delay:${0.08 + i * 0.07}s`}>
          <img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <span class:list={["absolute top-3 left-3 text-[11px] font-bold px-3 py-1.5 rounded-full", p.badge === 'Teruji' ? "bg-amber-700 text-white" : "bg-white/90 text-zinc-900"]}>{p.badge === 'Teruji' ? 'Grosir ready' : 'Ecer'}</span>
          <div class="acc-label absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-zinc-950/80 to-transparent text-white">
            <p class="font-bold tracking-tight">{p.name}</p>
            <p class="text-sm text-zinc-300">{p.price}</p>
            <a href={waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Grosir/ecer ready?`)} class="mt-2 inline-block bg-white text-zinc-950 px-5 py-2 rounded-full text-sm font-medium active:scale-[0.98]">Pesan via WA</a>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-4 text-xs text-zinc-400">Badge: Grosir ready = stok kulakan tersedia • Ecer = satuan. Harga estimasi, konfirmasi via WA.</p>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-14 w-full">
    <div class="md:pl-[16vw] reveal">
      <h2 class="text-3xl md:text-4xl tracking-tighter leading-none font-extrabold max-w-[20ch]">Kulakan hari ini, ready besok?</h2>
      <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Chat admin online sebelum datang. Jelajahi <a class="underline underline-offset-4 text-zinc-900" href="/katalog">katalog</a>, <a class="underline underline-offset-4 text-zinc-900" href="/promo">promo</a>, <a class="underline underline-offset-4 text-zinc-900" href="/tentang">info toko</a>.</p>
      <a href={heroCta} class="mt-6 inline-block bg-amber-700 text-white px-8 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Chat Admin Online</a>
    </div>
  </section>
</BaseLayout>
