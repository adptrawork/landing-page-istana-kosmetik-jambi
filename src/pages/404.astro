---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman Tidak Ditemukan (404) — Istana Cosmetics Jambi" description="Halaman tidak ditemukan di situs Istana Cosmetics Jambi. Kembali ke beranda atau telusuri rak katalog kosmetik grosir dan ecer.">
  <!-- Ref: 404 editorial — display serif besar, tanpa aset berat -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 py-20 md:py-28 min-h-[70dvh] grid content-center" aria-labelledby="notfound-h">
    <p class="text-[0.68rem] font-medium uppercase tracking-[0.26em] text-accent">Error 404</p>
    <h1 id="notfound-h" class="mt-4 font-display text-[2.75rem] md:text-6xl leading-[1.04] tracking-tight text-ink max-w-[14ch]">Halaman tidak ditemukan</h1>
    <p class="mt-5 text-base text-soft leading-relaxed max-w-prose">Tautan mungkin sudah berubah. Kembali ke beranda atau telusuri rak katalog, lalu minta pricelist via WhatsApp.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="inline-flex items-center justify-center bg-ink text-paper px-7 min-h-[48px] rounded-full text-sm font-medium tap hover:bg-accent">Beranda</a>
      <a href="/katalog" class="inline-flex items-center justify-center border rule text-ink px-7 min-h-[48px] rounded-full text-sm font-medium tap hover:border-accent hover:text-accent">Lihat rak produk</a>
    </div>
  </section>
</BaseLayout>
