---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, products, waLink } from '../data/business';
---
<BaseLayout title={`Katalog — ${business.title}`} description={`Katalog grosir ${business.name}: ${products.length} kosmetik, badge grosir vs ecer, slider gambar, pricelist WA.`} canonicalPath="/katalog" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <div class="md:pl-[10vw]">
      <p class="text-sm font-bold uppercase tracking-widest text-amber-700 reveal">Katalog Grosir</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold max-w-[20ch] reveal d-1">Semua Produk {business.name}</h1>
      <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Badge <strong>Grosir ready</strong> = bisa kulakan lusinan • <strong>Ecer</strong> = satuan. Arahkan kursor pada strip untuk memperbesar, klik pesan untuk pricelist.</p>
    </div>
    <div class="acc-strip mt-8 h-[52dvh] md:h-[64dvh]" role="list" aria-label="Slider seluruh produk">
      {products.map((p, i) => (
        <div class="acc-panel relative bg-zinc-100 border border-slate-200/50 reveal" role="listitem" tabindex="0" aria-label={p.name} style={`animation-delay:${(i % 4) * 0.06}s`}>
          <img src={p.image} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
          <span class:list={["absolute top-3 left-3 text-[11px] font-bold px-3 py-1.5 rounded-full", p.badge === 'Teruji' ? "bg-amber-700 text-white" : "bg-white/90 text-zinc-900"]}>{p.badge === 'Teruji' ? 'Grosir ready' : 'Ecer'}</span>
          <div class="acc-label absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-zinc-950/85 to-transparent text-white">
            <p class="font-bold tracking-tight text-sm">{p.name}</p>
            <p class="text-sm text-zinc-300">{p.price} • {p.stock}</p>
            <a href={waLink(`Halo ${business.name}, saya mau pesan ${p.name} (${p.price}). Grosir/ecer ready?`)} class="mt-2 inline-block bg-white text-zinc-950 px-5 py-2 rounded-full text-sm font-medium active:scale-[0.98]">Pesan via WA</a>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-4 text-sm">
      <div class="md:col-span-7 bg-amber-50 border border-amber-900/15 rounded-[2rem] p-6"><p class="font-bold">Butuh kulakan?</p><p class="mt-1 text-base text-gray-600 max-w-[65ch]">Minta pricelist grosir lusinan ke admin online sebelum datang.</p><a href={waLink(`Halo ${business.name}, saya mau minta pricelist grosir lengkap.`)} class="mt-3 inline-block bg-amber-700 text-white px-6 py-3 rounded-full font-medium active:scale-[0.98]">Minta Pricelist</a></div>
      <div class="md:col-span-5 bg-white border border-slate-200/50 rounded-[2rem] p-6"><p class="font-bold">Cari satuan?</p><p class="mt-1 text-base text-gray-600">Semua item ecer bisa dipesan satuan via WA.</p></div>
    </div>
  </section>
</BaseLayout>
