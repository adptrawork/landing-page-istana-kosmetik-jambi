---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, promos, waLink } from '../data/business';
---
<BaseLayout title={`Promo — ${business.title}`} description={`Promo grosir ${business.name} Bakaruddin: pricelist lusinan & paket ecer hemat. Chat admin.`} canonicalPath="/promo" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <div class="md:pl-[10vw]">
      <p class="text-sm font-bold uppercase tracking-widest text-amber-700 reveal">Promo Grosir</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-extrabold max-w-[20ch] reveal d-1">Promo {business.name}</h1>
      <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Pilih skema: <strong>Grosir</strong> untuk kulakan, <strong>Ecer</strong> untuk satuan. Harga final via admin online.</p>
    </div>
    <div class="mt-8 flex flex-col gap-5 max-w-4xl">
      {promos.map((m, i) => (
        <div class="reveal" style={`animation-delay:${i * 0.08}s`}>
          <div class="grid grid-cols-12 gap-4 items-center bg-white border border-slate-200/50 rounded-[2rem] p-6 md:p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
            <div class="col-span-12 md:col-span-8">
              <p class="text-xs font-bold uppercase tracking-widest text-amber-700">{i === 0 ? 'Grosir' : i === 1 ? 'Ecer' : 'Info'} • {m.status}</p>
              <h2 class="mt-2 font-extrabold text-xl tracking-tight">{m.title}</h2>
              <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">{m.desc}</p>
            </div>
            <div class="col-span-12 md:col-span-4 md:text-right">
              <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}.`)} class="inline-block bg-amber-700 text-white px-6 py-3 rounded-full text-sm font-medium active:scale-[0.98]">Klaim via WA</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
