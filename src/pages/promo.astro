---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/ui/Kicker.astro';
import Steps from '../components/ui/Steps.astro';
import { business, promos, waLink } from '../data/business';
const steps = [
  { t: "Pilih tier promo", d: "Cocokkan kebutuhan dengan tier di bawah — catat judul promonya." },
  { t: "Klik klaim via WA", d: "Tombol klaim mengisi format chat otomatis berisi judul promo." },
  { t: "Konfirmasi admin", d: "Admin memastikan promo masih berlaku dan harga final." },
];
---
<BaseLayout title={`Promo — ${business.title}`} description={`Promo ${business.name}: bundling hemat & program reseller. Estimasi, konfirmasi WA.`} canonicalPath="/promo" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full py-12 md:py-20" aria-labelledby="promo-h">
    <Kicker no="Promo" label="{promos.length} tier aktif" />
    <h1 id="promo-h" class="mt-2 text-4xl md:text-6xl tracking-tighter leading-[1.05] font-extrabold text-zinc-950 max-w-[20ch]">Bundling & promo {business.name}</h1>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Semua promo estimasi mengikuti info toko — harga final wajib konfirmasi via WA sebelum order.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      {promos.map((m, i) => (
        <div class={i === 0 ? "md:col-span-7" : i === 1 ? "md:col-span-5" : "md:col-span-12"}>
          <div class="bg-white border border-amber-900/10 rounded-[2.5rem] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] md:!p-10 transition-all duration-300 hover:-translate-y-1 h-full">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="font-mono text-xs tracking-[0.2em] uppercase text-amber-700">Tier 0{i + 1}</p>
              <p class="font-mono text-xs tracking-widest uppercase text-zinc-400">{m.status}</p>
            </div>
            <h2 class="mt-2 font-semibold text-xl tracking-tight text-zinc-950">{m.title}</h2>
            <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">{m.desc}</p>
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}. Apakah masih berlaku?`)} class="mt-5 inline-flex items-center justify-center bg-zinc-950 text-white px-6 min-h-[48px] rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Klaim via WA</a>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-12">
      <h2 class="font-mono text-xs tracking-[0.2em] uppercase text-amber-700">CARA KLAIM</h2>
      <Steps steps={steps} />
    </div>
    <div class="mt-8 bg-amber-50 border border-amber-200/60 rounded-[2rem] p-8">
      <h2 class="font-semibold text-lg tracking-tight text-zinc-950">Disclaimer</h2>
      <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">Harga dapat berubah, konfirmasi via WA toko. Promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko. Screenshot halaman ini bukan bukti klaim harga.</p>
    </div>
  </section>
</BaseLayout>
