---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, promos, waLink } from '../data/business';
---
<BaseLayout title={`Promo — ${business.title}`} description={`Promo & bundling ${business.name} bulan ini. Syarat mengikuti info toko, harga estimasi.`} canonicalPath="/promo" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 py-12 w-full min-h-[70dvh]">
    <p class="text-sm font-medium text-rose-700">Promo</p>
    <h1 class="mt-2 text-3xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Bundling & Promo {business.name}</h1>
    <p class="mt-3 text-base text-gray-600 leading-relaxed max-w-[65ch]">Semua promo bersifat estimasi dan mengikuti info toko — harga final dan ketersediaan wajib konfirmasi via WA sebelum order.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      {promos.map((m, i) => (
        <div class:list={[i === 0 ? "md:col-span-7" : "md:col-span-5", i === 2 && "md:col-span-7", i === 1 && "md:col-span-5"]}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] transition-all duration-300 hover:-translate-y-1 h-full">
            <p class="text-xs font-medium text-rose-700">{m.status}</p>
            <h2 class="mt-2 font-semibold text-xl tracking-tight">{m.title}</h2>
            <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">{m.desc}</p>
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}. Apakah masih berlaku?`)} class="mt-5 inline-block bg-zinc-950 text-white px-6 py-3 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Klaim via WA</a>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 bg-amber-50 border border-amber-200/60 rounded-[2.5rem] p-8">
      <h2 class="font-semibold text-lg tracking-tight">Disclaimer</h2>
      <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">Harga dapat berubah, konfirmasi via WA toko. Promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko. Screenshot halaman ini bukan bukti klaim harga.</p>
    </div>
  </section>
</BaseLayout>
