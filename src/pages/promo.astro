---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/ui/Kicker.astro';
import Steps from '../components/ui/Steps.astro';
import { business, promos, waLink } from '../data/business';
const steps = [
  { t: 'Pilih tier promo', d: 'Cocokkan kebutuhan dengan tier di bawah, lalu catat judul promonya.' },
  { t: 'Klik klaim via WA', d: 'Tombol klaim mengisi format chat otomatis berisi judul promo.' },
  { t: 'Konfirmasi admin', d: 'Admin memastikan promo masih berlaku dan menetapkan harga final.' },
];
const promoDescription = 'Promo Istana Cosmetics Jambi: harga grosir lusinan, bundling ecer hemat, dan konfirmasi stok online. Semua harga estimasi, konfirmasi via WhatsApp.';
const breadcrumb = [
  { name: 'Beranda', url: 'https://istanakosmetik-jambi.pages.dev/' },
  { name: 'Promo', url: 'https://istanakosmetik-jambi.pages.dev/promo' },
];
---
<BaseLayout title="Promo Hemat Grosir & Ecer — Istana Cosmetics Jambi" description={promoDescription} canonicalPath="/promo" image={business.ogImage} breadcrumb={breadcrumb}>
  <!-- Ref: promo sebagai list ber-rule dengan status terverifikasi/estimasi, bukan kartu berbayang -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 w-full pt-10 pb-16 md:pt-16 md:pb-24" aria-labelledby="promo-h">
    <Kicker no="Promo" label={`${promos.length} program aktif`} />
    <h1 id="promo-h" class="mt-4 font-display text-[2.5rem] md:text-6xl leading-[1.04] tracking-tight text-ink max-w-[16ch]">Bundling &amp; promo toko</h1>
    <p class="mt-5 text-base text-soft leading-relaxed max-w-prose">Semua promo mengikuti info toko. Harga final wajib dikonfirmasi via WhatsApp sebelum order — status di bawah menandai mana yang sudah terverifikasi dan mana yang estimasi.</p>

    <div class="mt-12 border-t rule">
      {promos.map((m, i) => (
        <article class="reveal grid md:grid-cols-12 gap-5 md:gap-10 items-start py-8 md:py-10 border-b rule" style={`--i:${i}`}>
          <div class="md:col-span-4">
            <p class="font-display text-4xl md:text-5xl leading-none text-blush" aria-hidden="true">0{i + 1}</p>
            <p class="mt-3 text-[0.64rem] font-medium uppercase tracking-[0.2em] text-soft">Tier 0{i + 1}</p>
          </div>
          <div class="md:col-span-5">
            <h2 class="font-display text-2xl md:text-3xl leading-snug text-ink">{m.title}</h2>
            <p class="mt-3 text-base text-soft leading-relaxed max-w-prose">{m.desc}</p>
            <p class:list={["mt-4 inline-flex items-center gap-2 text-[0.66rem] font-medium uppercase tracking-[0.18em]", m.status.startsWith('Terverifikasi') ? "text-accent" : "text-soft"]}>
              <span class:list={["h-1.5 w-1.5", m.status.startsWith('Terverifikasi') ? "bg-accent" : "bg-blush"]} aria-hidden="true"></span>
              {m.status}
            </p>
          </div>
          <div class="md:col-span-3 md:justify-self-end">
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}. Apakah masih berlaku?`)} class="inline-flex items-center justify-center gap-2 bg-ink text-paper px-6 min-h-[46px] rounded-full text-sm font-medium tap hover:bg-accent">
              Klaim via WA
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 grid md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5">
        <h2 class="font-display text-2xl md:text-3xl text-ink">Cara klaim promo</h2>
        <p class="mt-3 text-base text-soft leading-relaxed max-w-prose">Tiga langkah, semuanya lewat admin online agar harga dan stok tercatat.</p>
      </div>
      <div class="md:col-span-7">
        <Steps steps={steps} />
      </div>
    </div>

    <div class="mt-12 border-t border-b rule py-7 grid md:grid-cols-12 gap-4">
      <h2 class="md:col-span-3 text-[0.66rem] font-medium uppercase tracking-[0.24em] text-soft">Catatan</h2>
      <p class="md:col-span-9 text-base text-soft leading-relaxed max-w-prose">Harga dapat berubah, konfirmasi via WA toko. Promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko. Tangkapan layar halaman ini bukan bukti klaim harga.</p>
    </div>
  </section>
</BaseLayout>
