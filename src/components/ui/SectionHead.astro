---
import Kicker from './Kicker.astro';
interface Props { no: string; kicker: string; title: string; desc?: string; id?: string; }
const { no, kicker, title, desc, id } = Astro.props;
---
<!-- Ref: kepala section editorial — display serif kiri, tanpa centering -->
<div class="max-w-prose">
  <Kicker no={no} label={kicker} />
  <h2 id={id} class="mt-4 font-display text-3xl md:text-4xl lg:text-[2.75rem] leading-[1.08] tracking-tight text-ink">{title}</h2>
  {desc && <p class="mt-4 text-base text-soft leading-relaxed max-w-prose">{desc}</p>}
</div>
