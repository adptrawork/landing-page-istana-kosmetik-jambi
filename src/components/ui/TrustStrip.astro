---
interface Item { v: string; l: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const cls = (i: number) => i === 0 ? "pl-0 pr-4" : i === 2 ? "pl-4 md:pl-6 pr-0 md:border-l border-amber-900/10" : "pl-4 md:pl-6 pr-0 border-l border-amber-900/10";
---
<div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 bg-white border border-amber-900/10 rounded-[2.5rem] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] !p-6 md:!p-8">
  {items.map((t, i) => (
    <div class={cls(i)}>
      <p class="font-mono text-sm font-semibold text-zinc-950 card-clamp">{t.v}</p>
      <p class="mt-1 text-sm text-zinc-400">{t.l}</p>
    </div>
  ))}
</div>
