---
interface Item { v: string; l: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<!-- Ref: strip fakta ber-rule — dipisah garis, bukan kartu berbayang -->
<div class="grid grid-cols-2 md:grid-cols-4 border-t border-b rule">
  {items.map((t, i) => (
    <div class:list={["py-6 px-4 md:px-6", i % 2 === 1 ? "border-l rule md:border-l" : "", i >= 2 ? "border-t rule md:border-t-0" : "", i === 2 ? "md:border-l" : ""]}>
      <p class="font-display text-xl md:text-2xl leading-tight text-ink card-clamp">{t.v}</p>
      <p class="mt-1.5 text-[0.72rem] uppercase tracking-[0.16em] text-soft">{t.l}</p>
    </div>
  ))}
</div>
