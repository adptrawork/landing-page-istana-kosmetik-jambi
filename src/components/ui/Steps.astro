---
interface Step { t: string; d: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
  {steps.map((st, i) => (
    <li class="bg-white border border-amber-900/10 rounded-[2.5rem] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
      <p class="font-mono text-xs tracking-[0.2em] text-amber-700">0{i + 1}</p>
      <p class="mt-3 font-semibold text-lg tracking-tight text-zinc-950">{st.t}</p>
      <p class="mt-1 text-base text-gray-600 leading-relaxed">{st.d}</p>
    </li>
  ))}
</ol>
