---
interface Step { t: string; d: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<!-- Ref: langkah berurutan sebagai list ber-rule (bukan 3 kartu sama besar) -->
<ol class="grid grid-cols-1 md:grid-cols-3 gap-x-8">
  {steps.map((st, i) => (
    <li class="reveal grid gap-3 border-t rule pt-6 pb-7" style={`--i:${i}`}>
      <span class="font-display text-4xl leading-none text-accent" aria-hidden="true">0{i + 1}</span>
      <h3 class="font-semibold text-lg tracking-tight text-ink">{st.t}</h3>
      <p class="text-base text-soft leading-relaxed max-w-prose">{st.d}</p>
    </li>
  ))}
</ol>
