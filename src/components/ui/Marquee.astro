---
interface Props { items: string[] }
const { items } = Astro.props;
const row = [...items, ...items];
---
<div class="marquee bg-amber-50 border-y border-amber-900/10" aria-hidden="true">
  <div class="marquee-track py-3">
    {row.map((m) => (
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-amber-700 border border-amber-200/60 text-amber-800 rounded-full px-4 py-2 whitespace-nowrap">{m}</span>
    ))}
  </div>
</div>
