---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
  {items.map((f) => (
    <details class="faq bg-white border border-amber-900/10 rounded-[2.5rem] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] !rounded-3xl group">
      <summary class="font-semibold text-zinc-950 text-base">
        <span>{f.q}</span>
        <span class="plus font-mono text-xl leading-none" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-base text-gray-600 leading-relaxed">{f.a}</p>
    </details>
  ))}
</div>
