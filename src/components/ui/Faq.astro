---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<!-- Ref: FAQ accordion aksesibel — details/summary, state terbuka-tutup native -->
<div class="border-t rule">
  {items.map((f) => (
    <details class="faq border-b rule">
      <summary class="py-4 text-base md:text-lg text-ink hover:text-accent">
        <span class="font-display">{f.q}</span>
        <span class="plus text-accent" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </summary>
      <div class="faq-body pb-5 pr-8">
        <p class="text-base text-soft leading-relaxed max-w-prose">{f.a}</p>
      </div>
    </details>
  ))}
</div>
