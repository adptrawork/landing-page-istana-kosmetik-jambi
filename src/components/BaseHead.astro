---
interface Props { title: string; description: string; canonicalUrl: string; image?: string; }
import { business } from '../data/business';
const { title, description, canonicalUrl, image = business.ogImage } = Astro.props;
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const faq = [
  { q: 'Apakah Istana Cosmetics Jambi melayani pembelian grosir lusinan?', a: 'Ya. Istana melayani grosir dan ecer. Minta pricelist grosir ke admin online 0895-3219-71081 sebelum datang agar disiapkan.' },
  { q: 'Apakah ini cabang Pekanbaru?', a: 'Bukan. Ini Istana Cosmetics Jambi di Jl Kapt A Bakaruddin No.17, Kota Jambi. Telepon pusat 0761-8364069 hanya untuk rujukan.' },
  { q: 'Jam berapa Istana Cosmetics buka?', a: 'Setiap hari pukul 08.00–22.00. Chat admin online dulu untuk konfirmasi stok agar tidak kehabisan.' },
];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="id_ID" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "WholesaleStore",
  name: business.name, url: Astro.site?.toString(), image: ogImage, description: description,
  address: { "@type": "PostalAddress", streetAddress: business.address, addressLocality: business.city, addressRegion: "Jambi", addressCountry: "ID" },
  telephone: business.phone, openingHours: "Mo-Su 08:00-22:00",
  aggregateRating: { "@type": "AggregateRating", ratingValue: business.rating, reviewCount: business.reviewCount }
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
})} />
